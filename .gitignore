# OS and editor files
.DS_Store
.vscode/
.idea/

# Python
__pycache__/
*.pyc

# Assistant-generated local state is not version controlled (see sources/layout.md)
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Experiment runs: transcripts and diffs (see evals/README.md)
evals/runs/

# The home carries its own bundle as a carrier: a release offered to it and its evaluation reports are
# its own working files, never committed to this public repository (the privacy check does not read them).
.agents/incoming/*
!.agents/incoming/README.md
.agents/evaluation-*
