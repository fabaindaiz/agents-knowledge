#!/bin/sh
# Privacy gate for every push from this repository, by anyone: what a push publishes is the commit
# messages and the lines each commit adds, history included, so they must pass
# `bundle.py privacy --commits` (see AGENTS.md) as the tree passes `bundle.py privacy`, and no message may
# credit an assistant (`bundle.py trailers`). Enabled per clone with
#   git config core.hooksPath .githooks
# git gives the hook one line per ref on standard input: <local ref> <local sha> <remote ref> <remote sha>.
# Overriding a finding needs the user's explicit instruction and a `privacy-allow: <reason>` marker.
top=$(git rev-parse --show-toplevel) || exit 1
tool="$top/.agents/tools/bundle.py"
if [ ! -f "$tool" ]; then
    echo "pre-push: $tool is missing, so nothing can be checked; refusing the push rather than letting it through unchecked" >&2
    exit 1
fi
# The tools need Python 3.11 or newer; `python3` may be older, so look for one that is not.
python=""
for candidate in python3.20 python3.19 python3.18 python3.17 python3.16 python3.15 python3.14 python3.13 python3.12 \
        python3.11 python3 /opt/homebrew/bin/python3 /usr/local/bin/python3; do
    if command -v "$candidate" >/dev/null 2>&1 &&
            "$candidate" -c 'import sys; sys.exit(sys.version_info < (3, 11))' >/dev/null 2>&1; then
        python=$candidate
        break
    fi
done
if [ -z "$python" ]; then
    echo "pre-push: the tools need Python 3.11 or newer and none was found; refusing the push rather than letting it through unchecked" >&2
    exit 1
fi
remote=${1:-origin}  # git passes the remote's name (or its URL, when pushing to one with no name)
url=${2:-}
if git remote | grep -qxF -- "$remote"; then
    published="--remotes=$remote"
else
    # Pushed to a URL: the remote whose fetch or push URL it is, if one is configured; otherwise nothing
    # counts as published there, and every commit the push sends is read (slower, never unchecked).
    named=$(git config --get-regexp '^remote\..*\.(push)?url$' 2>/dev/null | awk -v u="$url" '$2 == u {sub(/^remote\./, "", $1); sub(/\.(push)?url$/, "", $1); print $1; exit}')
    if [ -n "$named" ]; then published="--remotes=$named"; else published="--exclude=* --remotes"; fi
fi
scratch=$(mktemp -d) || exit 1
trap 'rm -rf "$scratch"' EXIT
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
    case "$local_sha" in *[!0]*) ;; *) continue ;; esac  # a deletion publishes no commit
    # An annotated tag publishes its own message besides the commits it points to.
    if [ "$(git cat-file -t "$local_sha" 2>/dev/null)" = tag ]; then
        message="$scratch/TAG_MESSAGE"
        git cat-file -p "$local_sha" | sed '1,/^$/d' | sed -E '/^-----BEGIN (PGP SIGNATURE|SSH SIGNATURE|SIGNED MESSAGE)-----$/,$d' >"$message"
        if ! "$python" "$tool" privacy --paths "$message" </dev/null; then
            echo "pre-push: $local_ref -> $remote_ref blocked: the tag's message fails \`bundle.py privacy\`." \
                "Recreate the tag with a clean message; only on the user's explicit instruction add \`privacy-allow: <reason>\` on that line." >&2
            status=1
        fi
        if ! "$python" "$tool" trailers --message "$message" </dev/null; then
            echo "pre-push: $local_ref -> $remote_ref blocked: the tag's message credits an assistant;" \
                "the user is the sole author (AGENTS.md). Recreate the tag without it." >&2
            status=1
        fi
    fi
    # A ref the remote already has: what is new since it. A new ref, or a remote tip this clone does
    # not hold (a force push): every commit the remote pushed to does not hold, as far as its
    # remote-tracking refs say (another remote holding a commit does not make it published here).
    range="$local_sha --not $published"
    case "$remote_sha" in
        *[!0]*) git cat-file -e "$remote_sha^{commit}" 2>/dev/null && range="$remote_sha..$local_sha" ;;
    esac
    if ! "$python" "$tool" privacy --commits "$range" --repo "$top" </dev/null; then
        echo "pre-push: $local_ref -> $remote_ref blocked: a commit message or an added line fails \`bundle.py privacy\`." \
            "Fix the commit (reword or rewrite it); only on the user's explicit instruction add \`privacy-allow: <reason>\` on that line." >&2
        status=1
    fi
    if ! "$python" "$tool" trailers "$range" --repo "$top" </dev/null; then
        echo "pre-push: $local_ref -> $remote_ref blocked: a commit message carries an attribution line crediting an assistant;" \
            "the user is the sole author of every commit (AGENTS.md). Reword the commit to remove it." >&2
        status=1
    fi
done
exit $status
