{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/privacy_guard.py\" remind"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/privacy_guard.py\" gate",
            "timeout": 120,
            "statusMessage": "Privacy check before git commit/push"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Edit(/.agents/SHA256SUMS)"
    ],
    "ask": [
      "Edit(/.claude/hooks/**)",
      "Edit(/.claude/settings.json)",
      "Edit(/.githooks/**)",
      "Edit(/.agents/tools/**)",
      "Edit(/.agents/agents/**)",
      "Edit(/.agents/method/**)",
      "Edit(/.agents/knowledge/**)",
      "Edit(/.agents/README.md)",
      "Edit(/.agents/CHANGELOG.md)",
      "Edit(/.agents/proposals/README.md)",
      "Edit(/.agents/proposals/RECEIVED.md)",
      "Edit(/.claude/skills/*/SKILL.md)",
      "Edit(/.claude/agents/**)"
    ]
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  }
}
